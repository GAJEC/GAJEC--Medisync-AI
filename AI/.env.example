# Copy to AI/.env. Never commit AI/.env.
AI_HOST=127.0.0.1
AI_PORT=8001
# Long random secret shared with Backend/.env AI_INTERNAL_TOKEN.
AI_INTERNAL_TOKEN=change-me-to-a-long-random-string

AI_WEIGHTS_DIR=weights
AI_LOAD_ON_STARTUP=true

# MedGemma 4B IT (local v1.0.1). 4bit is required on 6 GB GPUs.
MEDGEMMA_ENABLED=true
MEDGEMMA_DEVICE=auto
MEDGEMMA_QUANTIZATION=4bit
# auto = bfloat16 (Gemma 3 can overflow in fp16; bf16 is emulated but works on RTX 20xx)
MEDGEMMA_COMPUTE_DTYPE=auto
# auto = float16 vision encoder on GPUs without native bf16 (40x faster on RTX 2060)
MEDGEMMA_VISION_DTYPE=auto
MEDGEMMA_MAX_NEW_TOKENS=700
MEDGEMMA_MAX_INPUT_CHARS=6000
MEDGEMMA_MAX_HISTORY_MESSAGES=10

WHISPER_ENABLED=true
WHISPER_DEVICE=auto

# Experimental voice-emotion model. Off by default; CPU avoids competing for VRAM.
MERALION_ENABLED=false
MERALION_DEVICE=cpu

AI_MAX_IMAGE_BYTES=10485760
AI_MAX_AUDIO_BYTES=15728640
AI_MAX_AUDIO_SECONDS=120
AI_QUEUE_TIMEOUT_SECONDS=120
