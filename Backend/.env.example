# Copy to Backend/.env and fill in. Never commit Backend/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (the Vite dev server by default). Never "*" in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medisync
DB_USER=medisync_app
# Import database/schema.sql once, and create this user with access to the medisync database.
DB_PASSWORD=

# Private Python AI service. Token must equal AI/.env AI_INTERNAL_TOKEN.
AI_BASE_URL=http://127.0.0.1:8001
AI_INTERNAL_TOKEN=
AI_INFERENCE_TIMEOUT_MS=240000
AI_AUDIO_TIMEOUT_MS=120000

# Experimental voice-emotion analysis (also requires MERALION_ENABLED=true in AI/.env).
FEATURE_VOICE_ANALYSIS=false

UPLOAD_DIR=storage/uploads
MAX_IMAGE_BYTES=10485760
MAX_AUDIO_BYTES=15728640
RETAIN_IMAGES=true
RETAIN_AUDIO=false

SESSION_TTL_HOURS=24
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_INFERENCE_PER_MIN=8
RATE_LIMIT_SESSIONS_PER_HOUR=20
